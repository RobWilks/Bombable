<?xml version="1.0"?>

<PropertyList>

	<description>navalGun</description>
	<author>Rob Wilkinson</author>
	<status>early-production</status>
	<path>navalGun.ac</path>
	<animation>
		<type>scale</type>
		<x-offset>1.5</x-offset>
		<y-offset>1.5</y-offset>
		<z-offset>1.5</z-offset>
	</animation>
	
	<animation>
		<type>rotate</type>
		<object-name>tourelle</object-name>
		<object-name>canon</object-name>
		<property>surface-positions/turret-pos-deg</property>
		<interpolation>
			<entry><ind>-180</ind><dep>-150</dep></entry><!-- right -->
			<entry><ind>-150</ind><dep>-150</dep></entry><!-- right -->
			<entry><ind>150</ind><dep>150</dep></entry><!-- left -->
			<entry><ind>180</ind><dep>150</dep></entry><!-- left -->
		</interpolation>
		<center>
			<x-m>0.696</x-m>
			<y-m>0.0</y-m>
			<z-m>-0.799</z-m>
		</center>
		<axis>
			<x>0</x>
			<y>0</y>
			<z>1</z>
		</axis>
	</animation>

	<animation>
		<type>rotate</type>
		<object-name>canon</object-name>
		<property>surface-positions/cannon-elev-deg</property>
		<interpolation>
			<entry><ind>-90</ind><dep>-10</dep></entry>
			<entry><ind>-10</ind><dep>-10</dep></entry>
			<entry><ind>45</ind><dep>45</dep></entry>
			<entry><ind>90</ind><dep>45</dep></entry>
		</interpolation>
		<center>
			<x-m>-0.967</x-m>
			<y-m>0.0</y-m>
			<z-m>0.656</z-m>
		</center>
		<axis>
			<x>0</x>
			<y>1</y>
			<z>0</z>
		</axis>
	</animation>
		
</PropertyList>
