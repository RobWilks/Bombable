<?xml version="1.0" encoding="UTF-8"?>
<PropertyList>

    <particlesystem>
        <name>weapons tracer</name>
        <texture>spark128.png</texture>
        <emissive>true</emissive>
        <lighting>false</lighting>
        <type>normal</type>
        <align>billboard</align>
        <attach>world</attach>
        
        <offsets>
            <!-- <x-m><value>{OFFSET_X}/offset-x</value></x-m>
            <y-m><value>{OFFSET_Y}/offset-y</value></y-m>
            <z-m><value>{OFFSET_Z}/offset-z</value></z-m>           -->
            <x-m><property>{WEAPON_PROP_ROOT}/offset-x</property></x-m>
            <y-m><property>{WEAPON_PROP_ROOT}/offset-y</property></y-m>
            <z-m><property>{WEAPON_PROP_ROOT}/offset-z</property></z-m>          
            <pitch-deg>90</pitch-deg>
            <heading-deg>180</heading-deg>
        </offsets>

		<condition>
		  <and>
				<property>/bombable/menusettings/fire-particles/ai-weapon-fire-visual-trigger</property><!--overall on/off-->
				<property>{WEAPON_PROP_ROOT}/ai-weapon-firing</property>
				<!--local on/off, whether or not firing at the moment-->
			</and>	
		</condition>


        <placer>
            <type>sector</type>
            <radius-min-m>0.0</radius-min-m>
            <radius-max-m>0.01</radius-max-m>
            <theta-min-deg>0</theta-min-deg>
            <theta-max-deg>0</theta-max-deg>
            <phi-min-deg>0</phi-min-deg>
            <phi-max-deg>0</phi-max-deg>
        </placer>

        <shooter>
            <theta-min-deg>0.0</theta-min-deg>
            <theta-max-deg>0.0</theta-max-deg>
            <phi-min-deg>0.0</phi-min-deg>
            <phi-max-deg>0.0</phi-max-deg>
            <speed-mps>
                <property>{WEAPON_PROP_ROOT}/speed</property>
            </speed-mps>
        </shooter>      

        <counter>
            <particles-per-sec>
                <value>{PARTICLES_PER_SEC}</value>
                <spread>0</spread>
            </particles-per-sec>
        </counter>
        
        <particle>
            <start>
				<color>
					<red>
						<value>1.0</value>
					</red>
					<green>
						<value>1.0</value>
					</green>
					<blue>
						<value>1.0</value>
					</blue>
					<alpha>
						<value>0.5</value>
					</alpha>
				</color>
                <size><value>{START_SIZE}</value></size>
            </start>
            <end>
				<color>
					<red>
						<value>1.0</value>
					</red>
					<green>
						<value>1.0</value>
					</green>
					<blue>
						<value>1.0</value>
					</blue>
					<alpha>
						<value>0.0</value>
					</alpha>
				</color>
                <size><value>{END_SIZE}</value></size>
            </end>
            <life-sec><value>10</value></life-sec>
            <mass-kg>0.05</mass-kg>
            <radius-m>0.001</radius-m>
        </particle>
        
        <program>
            <fluid>air</fluid>
            <gravity type="bool">false</gravity>
            <wind type="bool">true</wind>
        </program>
    </particlesystem>
</PropertyList>