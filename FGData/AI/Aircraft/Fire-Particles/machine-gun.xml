<?xml version="1.0" encoding="UTF-8"?>
<PropertyList>
    <particlesystem>
        <name>weapons tracer</name>
        <texture>projectile.png</texture>
        <emissive>true</emissive>
        <lighting>false</lighting>
        <type>normal</type>
        <align>billboard</align>
        <attach>world</attach>
        
        <offsets>
            <x-m>{OFFSET_X}</x-m>
            <y-m>{OFFSET_Y}</y-m>
            <z-m>{OFFSET_Z}</z-m>          
            <pitch-deg>90</pitch-deg>
            <heading-deg>180</heading-deg>
        </offsets>

        <placer>
            <type>sector</type>
            <radius-min-m>0.0</radius-min-m>
            <radius-max-m>0.01</radius-max-m>
            <theta-min-deg>0</theta-min-deg>
            <theta-max-deg>0</theta-max-deg>
            <phi-min-deg>0</phi-min-deg>
            <phi-max-deg>0</phi-max-deg>
        </placer>

        <shooter>
            <theta-min-deg>0.0</theta-min-deg>
            <theta-max-deg>0.0</theta-max-deg>
            <phi-min-deg>0.0</phi-min-deg>
            <phi-max-deg>0.0</phi-max-deg>
            <speed-mps>
                <property>{WEAPON_PROP_ROOT}/speed</property>
                <value>700.0</value>
            </speed-mps>
        </shooter>      

        <counter>
            <particles-per-sec>
                <value>10</value>
                <spread>0</spread>
            </particles-per-sec>
        </counter>
        
        <particle>
            <start>
                <color>
                    <red><value>0.92</value></red>
                    <green><value>0.12</value></green>
                    <blue><value>0.12</value></blue>
                    <alpha><value>0.8</value></alpha>
                </color>
                <size>{START_SIZE}</size>
            </start>
            <end>
                <color>
                    <red><value>0.85</value></red>
                    <green><value>0.15</value></green>
                    <blue><value>0.15</value></blue>
                    <alpha><value>0.45</value></alpha>
                </color>
                <size>{END_SIZE}</size>
            </end>
            <life-sec><value>10</value></life-sec>
            <mass-kg>0.05</mass-kg>
            <radius-m>0.001</radius-m>
        </particle>
        
        <program>
            <fluid>air</fluid>
            <gravity type="bool">false</gravity>
            <wind type="bool">true</wind>
        </program>
    </particlesystem>
</PropertyList>