	<!-- Specularity fix -->
	<animation>
		<type>material</type>
		<object-name>Canopy-F-Port</object-name>
		<object-name>Canopy-F-Stbd</object-name>
		<object-name>Canopy-FP</object-name>
		<object-name>Canopy-Main</object-name>
		<object-name>Armour-Panel</object-name>
		<object-name>Fuselage</object-name>
		<object-name>Elevator-L</object-name>
		<object-name>Elevator-R</object-name>
		<object-name>Filet</object-name>
		<object-name>Tailplane-T.001</object-name>
		<object-name>Tailplane-B.001</object-name>
		<object-name>Fillet</object-name>
		<object-name>Tailplane-T.mesh</object-name>
		<object-name>Tailplane-B.mesh</object-name>
		<object-name>Tail.001</object-name>
		<object-name>Rudder-O</object-name>
		<object-name>Hull-Aft.001</object-name>
		<object-name>Stub-Wing-L</object-name>
		<object-name>Stub-Wing-R</object-name>
		<object-name>Wing-L</object-name>
		<object-name>Wing-R</object-name>
		<shininess>116</shininess>
		<specular>
			<r>1</r>
			<g>1</g>
			<b>1</b>
		</specular>
		<ambient>
			<r>1</r>
			<g>1</g>
			<b>1</b>
		</ambient>
	</animation>


	<!-- ***** Propeller ***** -->
	<animation>
		<type>select</type>
		<object-name>Propeller</object-name>
		<condition>
			<less-than>
				<property>/spitfireXVI/engines/engine[0]/rpm</property>
				<value>1000</value>
			</less-than>
		</condition>
	</animation>
	<animation>
		<type>spin</type>
		<object-name>Propeller</object-name>
		<property>/spitfireXVI/engines/engine[0]/rpm</property>
		<factor>0.477</factor>
		<center>
			<x-m>-0.40</x-m>
			<y-m>0.0</y-m>
			<z-m>0.0</z-m>
		</center>
		<axis>
			<x>-1.0</x>
			<y>0.0</y>
			<z>0.0</z>
		</axis>
	</animation>
	<animation>
		<type>spin</type>
		<object-name>Spinner</object-name>
		<property>/spitfireXVI/engines/engine[0]/rpm</property>
		<factor>0.477</factor>
		<center>
			<x-m>-0.40</x-m>
			<y-m>0.0</y-m>
			<z-m>0.0</z-m>
		</center>
		<axis>
			<x>-1.0</x>
			<y>0.0</y>
			<z>0.0</z>
		</axis>
	</animation>
	<animation>
		<type>select</type>
		<object-name>PropellerDisk</object-name>
		<condition>
			<greater-than>
				<property>/spitfireXVI/engines/engine[0]/rpm</property>
				<value>900</value>
			</greater-than>
		</condition>
	</animation>
	<animation>
		<type>blend</type>
		<object-name>PropellerDisk</object-name>
		<property>/spitfireXVI/engines/engine[0]/rpm</property>
		<factor>0.0005</factor>
		<offset>-0.5</offset>
		<min>0.0</min>
		<max>1</max>
	</animation>

</PropertyList>
