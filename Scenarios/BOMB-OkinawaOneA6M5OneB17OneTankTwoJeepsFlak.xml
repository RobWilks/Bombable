<?xml version="1.0"?>
<PropertyList>
  <scenario>
    <name>Bombable: Ground and air battle for Okinawa</name>
    <description>1 B-17 and 2 light tanks on mission to Okinawa guarded by AA battery, one Zero and two light tanks.</description>
    <!-- B-17s -->
    <entry>
      <search-order>PREFER_AI</search-order>
      <type>aircraft</type>
      <callsign>B17_Doomed_B</callsign>
      <name>B17-2</name>
      <model type="string">Aircraft/B-17-Bombable/Models/b17.xml</model>
      <latitude type="double">26.1902</latitude>
      <longitude type="double">127.6372</longitude>
      <altitude type="double">5100</altitude>
      <speed>182</speed>
      <bank type="double">0</bank>
      <heading type="double">180.1</heading>
    </entry>
    <!--  Tank -->
    <entry>
      <search-order>PREFER_AI</search-order>
      <type>ship</type>
      <name>Flaming_Ego_Y</name>
      <model type="string">Aircraft/Scimitar-Bombable/Scimitar.xml</model>
      <latitude type="double">26.2059</latitude>
      <longitude type="double">127.648</longitude>
      <altitude>16</altitude>
      <speed>6.0</speed>
      <rudder type="double">25</rudder>
      <heading type="double">0</heading>
    </entry>    
    <!--  Tank_2.1 -->
    <entry>
      <search-order>PREFER_AI</search-order>
      <type>ship</type>
      <name>Rattle_n_Hum_E</name>
      <model type="string">Aircraft/jeep-Bombable/Models/WW2Jeep.xml</model>
      <latitude type="double">26.2049</latitude>
      <longitude type="double">127.648</longitude>
      <altitude>16</altitude>
      <speed>6.0</speed>
      <rudder type="double">25</rudder>
      <heading type="double">0</heading>
    </entry>    
    <!--  Tank 2.2 -->
    <entry>
      <search-order>PREFER_AI</search-order>
      <type>ship</type>
      <name>Smite_E</name>
      <model type="string">Aircraft/jeep-Bombable/Models/WW2Jeep.xml</model>
      <latitude type="double">26.2059</latitude>
      <longitude type="double">127.649</longitude>
      <altitude>16</altitude>
      <speed>6.0</speed>
      <rudder type="double">25</rudder>
      <heading type="double">0</heading>
    </entry>    
    <!--  First Zero Squadron -->
    <entry>
      <search-order>PREFER_AI</search-order>
      <type>aircraft</type>
      <callsign>A6M2_No_Tommorow_X</callsign>
      <name>A6M21</name>
      <model type="string">Aircraft/A6M2-Bombable/Models/a6m2-anim.xml</model>
      <latitude type="double">26.1851097548720</latitude>
      <longitude type="double">127.6384</longitude>
      <altitude type="double">6000</altitude>
      <speed>250</speed>
      <bank type="double">0</bank>
      <heading type="double">160</heading>
      <performance-class>ww2_fighter</performance-class>
    </entry>
    <!--  Flak battery at airport -->
    <entry>
      <search-order>PREFER_AI</search-order>
      <type>static</type>
      <name>AA_battery_W</name>
      <model type="string">Aircraft/AA-battery-Bombable/AA-battery.xml</model>
      <latitude type="double">26.1902</latitude>
      <longitude type="double">127.6392</longitude>
      <altitude type="double">5100</altitude>
      <heading type="double">0</heading>
    </entry>
  </scenario>
  <extension>
    <group>
        <!-- B17s -->
        <team>B</team>
        <target>X</target>
        <arrivalTime>240</arrivalTime>
        <airSpeed>182</airSpeed>
        <airportName>ROAH</airportName>
        <heading>225</heading>
        <alt>5000</alt>
        <offsets>
            <offset>
                <behind>0</behind>
                <right>0</right>
                <up>0</up>
            </offset>
        </offsets>
        <flightpath>
            <name type="string">target_runway</name>
            <segmentLength type="double">3.0</segmentLength>
        </flightpath>
    </group>
    <group>
        <!-- Tank -->
        <team>Y</team>
        <target>E</target>
        <arrivalTime>-30</arrivalTime>
        <airSpeed>1</airSpeed>
        <airportName>ROAH</airportName>
        <heading>0</heading>
        <alt>16</alt>
        <offsets>
            <offset>
                <behind>0</behind>
                <right>400</right>
                <up>0</up>
            </offset>
        </offsets>
    </group>
    <group>
        <!-- Two Jeeps -->
        <team>E</team>
        <target>Y</target>
        <arrivalTime>360</arrivalTime>
        <airSpeed>30</airSpeed>
        <airportName>ROAH</airportName>
        <heading>315</heading>
        <alt>30</alt>
        <offsets>
            <offset>
                <behind>0</behind>
                <right>0</right>
                <up>0</up>
            </offset>
            <offset>
                <behind>100</behind>
                <right>30</right>
                <up>0</up>
            </offset>
        </offsets>
    </group>
    <!-- Flak -->
    <group>
        <team>W</team>
        <target>B</target>
        <arrivalTime>0</arrivalTime>
        <airSpeed>0</airSpeed>
        <airportName>ROAH</airportName>
        <heading>0</heading>
        <alt>100</alt>
        <offsets>
            <offset>
                <behind>-1000</behind>
                <right>1000</right>
                <up>0</up>
            </offset>
        </offsets>
    </group>
    <!-- Zero -->
    <group>
        <team>X</team>
        <target>B</target>
        <arrivalTime>90</arrivalTime>
        <airSpeed>250</airSpeed>
        <airportName>ROAH</airportName>
        <heading>160</heading>
        <alt>6000</alt>
        <offsets>
            <offset>
                <behind>0</behind>
                <right>0</right>
                <up>0</up>
            </offset>
        </offsets>
    </group>
  </extension>
</PropertyList>
