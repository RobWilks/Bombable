  <!-- =================================================================== -->
  <!-- MODEL DISTANCE / LOD OPTIMIZATION                                   -->
  <!-- =================================================================== -->
  <range-m>5000</range-m>

  <!-- =================================================================== -->
  <!-- MATERIAL & TEXTURE ANIMATIONS                                      -->
  <!-- =================================================================== -->
  <!-- Kept intact to preserve correct surface shading and livery rendering -->
  <animation>
    <type>material</type>
    <object-name>fuselage</object-name>
    <object-name>aileG</object-name>
    <object-name>aileD</object-name>
    <object-name>profondeurG</object-name>
    <object-name>profondeurD</object-name>
    <object-name>direction</object-name>
    <object-name>aileronG</object-name>
    <object-name>aileronD</object-name>
    <object-name>voletG1</object-name>
    <object-name>voletG2</object-name>
    <object-name>voletD1</object-name>
    <object-name>voletD2</object-name>
    <object-name>axeG</object-name>
    <object-name>axeD</object-name>
    <object-name>roueG</object-name>
    <object-name>roueD</object-name>
    <object-name>roueA</object-name>
    <object-name>porteGA</object-name>
    <object-name>porteGB</object-name>
    <object-name>porteDA</object-name>
    <object-name>porteDB</object-name>
    <object-name>ailetteG1</object-name>
    <object-name>ailetteG2</object-name>
    <object-name>ailetteD1</object-name>
    <object-name>ailetteD2</object-name>
    <object-name>tourverriere</object-name>
    <object-name>hook</object-name>
    <property-base>sim/model/livery</property-base>
    <texture-prop>texture</texture-prop>
    <texture>f6f.png</texture>
  </animation>

  <!-- Glass material definitions -->
  <animation>
    <type>material</type>
    <object-name>verriere</object-name>
    <object-name>Canopy</object-name>
    <property-base>sim/model/livery</property-base>
    <texture-prop>texture-glass</texture-prop>
    <texture>glass.png</texture>
  </animation>

  <!-- =================================================================== -->
  <!-- PROPELLER & ENGINE ANIMATIONS (KEPT ACTIVE)                         -->
  <!-- =================================================================== -->

  <!-- Static Propeller (Visible when engine is stopped or idle) -->
  <animation>
    <type>select</type>
    <object-name>helice</object-name>
    <condition>
      <less-than>
        <property>engines/engine[0]/rpm</property>
        <value>1000.0</value>
      </less-than>
    </condition>
  </animation>

  <!-- Propeller & Spinner Rotation -->
  <animation>
    <type>spin</type>
    <object-name>helice</object-name>
    <object-name>bol</object-name>
    <property>engines/engine[0]/rpm</property>
    <factor>1.0</factor>
    <center>
      <x-m>-2.60</x-m>
      <y-m>0.00</y-m>
      <z-m>0.00</z-m>
    </center>
    <axis>
      <x>-1.0</x>
      <y>0.0</y>
      <z>0.0</z>
    </axis>
  </animation>

  <!-- Medium RPM Blur Disc -->
  <animation>
    <type>select</type>
    <object-name>propblur</object-name>
    <condition>
      <and>
        <greater-than>
          <property>engines/engine[0]/rpm</property>
          <value>600.0</value>
        </greater-than>
        <less-than>
          <property>engines/engine[0]/rpm</property>
          <value>1500.0</value>
        </less-than>
      </and>
    </condition>
  </animation>

  <!-- High RPM Fast Disc -->
  <animation>
    <type>select</type>
    <object-name>propdisc</object-name>
    <condition>
      <greater-than>
        <property>engines/engine[0]/rpm</property>
        <value>1400.0</value>
      </greater-than>
    </condition>
  </animation>

